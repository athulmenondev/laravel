{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "integer" },
      "roll_no": { "type": "string" },
      "name": { "type": "string" },
      "email": { "type": "string" },
      "department": { "type": "string" },
      "semester": { "type": "integer" },
      "cgpa": { "type": "number" }
    },
    "required": ["id", "roll_no", "name"]
  }
}