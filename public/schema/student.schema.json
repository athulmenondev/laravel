{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Student",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "roll_no": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "department": {
        "type": "string"
      },
      "semester": {
        "type": "integer"
      },
      "cgpa": {
        "type": ["number", "string"]
      },
      "created_at": {
        "type": ["string", "null"]
      },
      "updated_at": {
        "type": ["string", "null"]
      }
    },
    "required": [
      "id",
      "roll_no",
      "name",
      "email",
      "department",
      "semester",
      "cgpa"
    ]
  }
}