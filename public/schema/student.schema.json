{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "integer" },
      "roll_no": { "type": "string" },
      "name": { "type": "string" },
      "email": { "type": "string" },
      "department": { "type": "string" },
      "semester": { "type": "integer" },
      "cgpa": { "type": ["number", "string"] }
    },
    "required": ["id", "roll_no", "name", "email", "department", "semester", "cgpa"]
  }
}